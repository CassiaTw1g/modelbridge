{
  "name": "modelbridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MCP server that gives an MCP host a working sub-agent whose brain can be any Anthropic-compatible model",
  "scripts": {
    "ctl": "node scripts/ctl.mjs",
    "setup": "node scripts/ctl.mjs setup",
    "start": "node scripts/ctl.mjs start",
    "stop": "node scripts/ctl.mjs stop",
    "restart": "node scripts/ctl.mjs restart",
    "reload": "node scripts/ctl.mjs reload",
    "status": "node scripts/ctl.mjs status",
    "logs": "node scripts/ctl.mjs logs",
    "url": "node scripts/ctl.mjs url",
    "auto": "node scripts/ctl.mjs auto",
    "auto:on": "node scripts/ctl.mjs auto on",
    "auto:off": "node scripts/ctl.mjs auto off",
    "tunnel": "node scripts/ctl.mjs tunnel",
    "untunnel": "node scripts/ctl.mjs untunnel",
    "enable": "node scripts/ctl.mjs enable",
    "disable": "node scripts/ctl.mjs disable",
    "uninstall": "node scripts/ctl.mjs uninstall",
    "dev": "node src/server.ts",
    "selftest": "node scripts/selftest.mjs",
    "selftest:memory": "node scripts/selftest-memory.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "npm run typecheck && npm run test:loop && npm run test:sandbox && npm run test:approvals && npm run test:guard && npm run test:jobs && npm run test:setup && npm run selftest:memory",
    "test:loop": "node --test scripts/test-loop.mjs",
    "test:setup": "node --test scripts/test-setup.mjs",
    "test:sandbox": "node --test scripts/test-sandbox.mjs",
    "test:approvals": "node --test scripts/test-approvals.mjs",
    "test:guard": "node --test scripts/test-guard.mjs",
    "test:jobs": "node --test scripts/test-jobs.mjs",
    "accept": "node scripts/accept.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "typescript": "^7.0.2"
  }
}
